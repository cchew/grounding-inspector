{
  "name": "grounding-inspector-web",
  "version": "0.2.2",
  "description": "Vue 3 + Hono web app for Grounding Inspector — a Layer-3 groundedness evaluation tool for LLM outputs",
  "repository": {
    "type": "git",
    "url": "https://github.com/cchew/grounding-inspector.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-fixtures.mjs && vite",
    "serve": "npm run build && tsx src/server.ts",
    "build": "node scripts/copy-fixtures.mjs && node_modules/.bin/vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ajv": "^8.20.0",
    "driver.js": "^1.8.0",
    "hono": "^4.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
